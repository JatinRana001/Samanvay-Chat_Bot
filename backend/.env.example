ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Add the deployed frontend origin here; set VITE_API_BASE_URL on the frontend host.
# URL-encode passwords containing special characters (for example, @ as %40).
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.com:5432/postgres
# For Alembic migrations, use Supabase Session Pooler or direct connection; DDL is unreliable through the transaction pooler.
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.com:5432/postgres
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
