# Samanvay Environment Configuration Template
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# URL-encode passwords containing special characters (for example, @ as %40).
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.com:5432/postgres
# For Alembic migrations, use Supabase Session Pooler or direct connection; DDL is unreliable through the transaction pooler.
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.com:5432/postgres
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
REGULATORY_STALENESS_DAYS=180
ADMIN_SECRET_KEY=samanvay-prototype-secret
